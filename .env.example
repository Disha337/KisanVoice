# Copy this file to ".env" (Windows: copy .env.example .env) and fill what you have.
# Everything is optional: with no keys the app runs in clearly-labelled DEMO mode.

# ---- AI answers (pick ONE provider; the first key found is used) ----
# AI_PROVIDER=anthropic        # optional: anthropic | openai | gemini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---- Bolna phone-call demo (optional) ----
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# BOLNA_FROM_NUMBER=+91XXXXXXXXXX   # optional, must be a number in your Bolna account

# ---- Server ----
PORT=3000
# HOST=127.0.0.1   # keep default. Weather needs no key (Open-Meteo is free).
